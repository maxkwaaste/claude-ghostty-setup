# Ghostty config for Claude Code sessions
# Docs: ghostty +show-default-config

# Font
font-family = JetBrains Mono
font-size = 13

# Theme - dark, easy on the eyes
background = #1a1b26
foreground = #c0caf5
selection-background = #33467c
selection-foreground = #c0caf5
cursor-color = #0f766e

# Palette (Tokyo Night inspired, teal accent)
palette = 0=#15161e
palette = 1=#f7768e
palette = 2=#9ece6a
palette = 3=#e0af68
palette = 4=#7aa2f7
palette = 5=#bb9af7
palette = 6=#0f766e
palette = 7=#a9b1d6
palette = 8=#414868
palette = 9=#f7768e
palette = 10=#9ece6a
palette = 11=#e0af68
palette = 12=#7aa2f7
palette = 13=#bb9af7
palette = 14=#7dcfff
palette = 15=#c0caf5

# Window
window-padding-x = 8
window-padding-y = 4
window-decoration = true
macos-titlebar-style = tabs
# Ask before closing a surface. A Claude Code session is expensive to lose.
confirm-close-surface = true
# A new window starts in the same directory as the one you launched it from,
# which is what makes cmd-N the right key for a session handoff.
window-inherit-working-directory = true

# Mouse - Shift+click bypasses TUI mouse capture (fixes copy in Claude Code)
mouse-shift-capture = true

# Clipboard
clipboard-read = allow
clipboard-write = allow
copy-on-select = true

# Scrollback
scrollback-limit = 50000

# Shell integration
shell-integration = zsh

# Keybindings
# cmd-N is the handoff key: a real window, same directory, tiled by AeroSpace.
# cmd-T still tabs, but AeroSpace counts each tab as a window and will not
# tile them, so keep tabs for things you do not want side by side.
keybind = super+n=new_window
keybind = super+d=new_split:right
keybind = super+shift+d=new_split:down
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+shift+enter=toggle_fullscreen
